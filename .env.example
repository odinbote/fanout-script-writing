# Copy to .env and fill in what you have. Everything is optional; the free sources run without keys.
# https://scrapecreators.com  (Meta ad copy + transcripts, TikTok, Instagram, X, LinkedIn, live Reddit)
SCRAPECREATORS_API_KEY=
# https://console.apify.com/settings/integrations  (Amazon reviews + listing copy)
APIFY_TOKEN=
# https://stackapps.com/apps/oauth/register  (optional, raises the Stack Overflow quota)
STACKEXCHANGE_KEY=
